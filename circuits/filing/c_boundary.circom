pragma circom 2.0.0;
include "c_boundary_core.circom";

// Boundary circuit instance used for the measurements: 2 tag slots, 2 chains,
// SMT depth 64. Other sizes are generated by filing/build_circuits.sh
// (Boundary(NT, D) for NT in 1..16, D in {16, 64, 128}).
component main {public [z0, zn, tags, cid, acaddr, root_rcl, root_unl, root_at,
                        root_psl, y, d_proceeds, d_cost, d_income, c_prev, c_y,
                        closing]} = Boundary(2, 64);
