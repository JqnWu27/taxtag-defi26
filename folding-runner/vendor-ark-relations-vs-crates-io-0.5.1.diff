+// ---------------------------------------------------------------------------------------------
+// TaxTag addition (the only change of this vendored copy of ark-relations 0.5.1).
+//
+// `finalize()` + `to_matrices()` keep every original linear combination alive while they build
+// the inlined constraint rows, and then copy the rows once more. For circuits of about nine
+// million constraints that needs well over 20 GB. The method below produces exactly the rows that
+// `to_matrices()` would return, but hands each row to a callback as soon as it is known and frees
+// the original linear combinations while it goes, so its peak memory is that of the synthesis.
+// Nothing else in the crate is modified.
+// ---------------------------------------------------------------------------------------------
+impl<F: Field> ConstraintSystem<F> {
+    /// Inlines all linear combinations and passes the rows of the constraint matrices to `emit`
+    /// in the order `A_0, B_0, C_0, A_1, B_1, C_1, ...` (first argument: 0 for A, 1 for B, 2 for
+    /// C). A row has the format of `ConstraintSystem::make_row`. Returns the number of rows
+    /// emitted per matrix.
+    ///
+    /// The constraint system is CONSUMED by this call (its linear combinations are gone
+    /// afterwards); it must not be finalized or used for anything else.
+    pub fn stream_inlined_constraint_rows(
+        &mut self,
+        emit: &mut dyn FnMut(u8, Vec<(F, usize)>),
+    ) -> Option<[usize; 3]> {
+        if !self.should_construct_matrices() {
+            return None;
+        }
+        let n_lc = self.lc_map.len();
+        // 0: intermediate linear combination; 1, 2, 3: row of A, B, C
+        let mut kind = vec![0u8; n_lc];
+        for i in &self.a_constraints {
+            kind[i.0] = 1;
+        }
+        for i in &self.b_constraints {
+            kind[i.0] = 2;
+        }
+        for i in &self.c_constraints {
+            kind[i.0] = 3;
+        }
+        let mut num_times_used = self.lc_num_times_used(false);
+        let witness_off = self.num_instance_variables;
+        let mut emitted = [0usize; 3];
+        // inlined versions of the intermediate linear combinations that are still referenced
+        let mut live = BTreeMap::<LcIndex, LinearCombination<F>>::new();
+
+        // consuming iteration: every original linear combination is freed after its turn
+        let lc_map = core::mem::take(&mut self.lc_map);
+        for (index, lc) in lc_map {
+            let mut inlined = LinearCombination::new();
+            for &(coeff, var) in lc.iter() {
+                if var.is_lc() {
+                    let lc_index = var.get_lc_index().expect("should be lc");
+                    // a linear combination only depends on ones with lower indices
+                    let dep = live.get(&lc_index).expect("should be inlined");
+                    inlined.extend((dep * coeff).0.into_iter());
+                    num_times_used[lc_index.0] -= 1;
+                    if num_times_used[lc_index.0] == 0 {
+                        live.remove(&lc_index);
+                    }
+                } else {
+                    inlined.push((coeff, var));
+                }
+            }
+            inlined.compactify();
+
+            let k = kind[index.0];
+            if k != 0 {
+                let row = inlined
+                    .0
+                    .iter()
+                    .filter_map(|(coeff, var)| {
+                        if coeff.is_zero() {
+                            None
+                        } else {
+                            Some((
+                                *coeff,
+                                var.get_index_unchecked(witness_off)
+                                    .expect("no symbolic LCs"),
+                            ))
+                        }
+                    })
+                    .collect::<Vec<_>>();
+                emit(k - 1, row);
+                emitted[(k - 1) as usize] += 1;
+            }
+            // keep the inlined form only while something still refers to it
+            if num_times_used[index.0] > 0 {
+                live.insert(index, inlined);
+            }
+        }
+        Some(emitted)
+    }
+}
